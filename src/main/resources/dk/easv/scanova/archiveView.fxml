<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dk.easv.scanova.GUI.ArchiveController">

    <VBox styleClass="panel" HBox.hgrow="ALWAYS">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="10">
            <Label text="All Archives" styleClass="panel-title"/>
            <Label fx:id="archiveCountBadge" text="0" styleClass="count-badge"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ New archive" styleClass="btn-primary, btn-panel-header" onAction="#handleClearForm"/>
        </HBox>

        <TableView fx:id="archiveTable" VBox.vgrow="ALWAYS" prefHeight="350" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colArchiveName"   text="Archive Name" prefWidth="200"/>
                <TableColumn fx:id="colArchiveClient" text="Client"       prefWidth="150"/>
                <TableColumn fx:id="colArchiveStatus" text="Status"       prefWidth="80"/>
            </columns>
            <placeholder><Label text="No archives found." styleClass="page-subtitle"/></placeholder>
        </TableView>
    </VBox>

    <VBox styleClass="panel" prefWidth="290">
        <VBox styleClass="form-header">
            <Label fx:id="formTitle" text="Create New Archive" styleClass="panel-title"/>
            <Label text="Fill in the details below" styleClass="form-header-hint"/>
        </VBox>
        <VBox spacing="14">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <VBox spacing="5">
                <Label text="Archive Name" styleClass="field-label"/>
                <TextField fx:id="nameField" promptText="e.g. 2024 Invoices" styleClass="text-field"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Client" styleClass="field-label"/>
                <ComboBox fx:id="clientComboBox" maxWidth="Infinity" promptText="Select a client" styleClass="combo-box"/>
            </VBox>
            <Label fx:id="feedbackLabel" text="" styleClass="feedback-label"/>
            <Button fx:id="saveButton" text="Create Archive" styleClass="btn-primary, btn-form" onAction="#handleSaveArchive" maxWidth="Infinity"/>
            <Button text="Clear form" styleClass="btn-secondary, btn-form" onAction="#handleClearForm" maxWidth="Infinity"/>
        </VBox>
    </VBox>

</HBox>