<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dk.easv.scanova.GUI.BoxController">

    <VBox styleClass="panel" HBox.hgrow="ALWAYS">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="10">
            <Label text="All Boxes" styleClass="panel-title"/>
            <Label fx:id="boxCountBadge" text="0" styleClass="count-badge"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ New box" styleClass="btn-primary, btn-panel-header" onAction="#handleClearForm"/>
        </HBox>

        <TableView fx:id="boxTable" VBox.vgrow="ALWAYS" prefHeight="350" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colBoxLabel"   text="Box Label" prefWidth="150"/>
                <TableColumn fx:id="colBoxArchive" text="Archive"   prefWidth="150"/>
                <TableColumn fx:id="colBoxProfile" text="Profile"   prefWidth="120"/>
                <TableColumn fx:id="colBoxStatus"  text="Status"    prefWidth="80"/>
            </columns>
            <placeholder><Label text="No boxes found." styleClass="page-subtitle"/></placeholder>
        </TableView>
    </VBox>

    <VBox styleClass="panel" prefWidth="290">
        <VBox styleClass="form-header">
            <Label fx:id="formTitle" text="Create New Box" styleClass="panel-title"/>
            <Label text="Fill in the details below" styleClass="form-header-hint"/>
        </VBox>
        <VBox spacing="14">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <VBox spacing="5">
                <Label text="Box Label" styleClass="field-label"/>
                <TextField fx:id="labelField" promptText="e.g. BOX-001" styleClass="text-field"/>
                <Label text="Must match the physical label on the box" styleClass="form-hint"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Archive" styleClass="field-label"/>
                <ComboBox fx:id="archiveComboBox" maxWidth="Infinity" promptText="Select an archive" styleClass="combo-box"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Profile" styleClass="field-label"/>
                <ComboBox fx:id="profileComboBox" maxWidth="Infinity" promptText="Select a profile" styleClass="combo-box"/>
            </VBox>
            <Label fx:id="feedbackLabel" text="" styleClass="feedback-label"/>
            <Button fx:id="saveButton" text="Create Box" styleClass="btn-primary, btn-form" onAction="#handleSaveBox" maxWidth="Infinity"/>
            <Button text="Clear form" styleClass="btn-secondary, btn-form" onAction="#handleClearForm" maxWidth="Infinity"/>
        </VBox>
    </VBox>

</HBox>