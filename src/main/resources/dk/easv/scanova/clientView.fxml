<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dk.easv.scanova.GUI.ClientController">

    <VBox styleClass="panel" HBox.hgrow="ALWAYS">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="10">
            <Label text="All Clients" styleClass="panel-title"/>
            <Label fx:id="clientCountBadge" text="0" styleClass="count-badge"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ New client" styleClass="btn-primary, btn-panel-header" onAction="#handleClearForm"/>
        </HBox>

        <TableView fx:id="clientTable" VBox.vgrow="ALWAYS" prefHeight="320" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colClientName"   text="Client Name" prefWidth="400"/>
                <TableColumn fx:id="colClientStatus" text="Status"      prefWidth="80"/>
            </columns>
            <placeholder><Label text="No clients found." styleClass="page-subtitle"/></placeholder>
        </TableView>
    </VBox>

    <VBox styleClass="panel" prefWidth="290">
        <VBox styleClass="form-header">
            <Label fx:id="formTitle" text="Create new client" styleClass="panel-title"/>
            <Label text="Fill in the details below" styleClass="form-header-hint"/>
        </VBox>
        <VBox spacing="14">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <VBox spacing="5">
                <Label text="Client Name" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="e.g. WebLager A/S" styleClass="text-field"/>
            </VBox>
            <Label fx:id="feedbackLabel" text="" styleClass="feedback-label"/>
            <Button fx:id="saveButton" text="Create client" styleClass="btn-primary, btn-form" onAction="#handleSaveClient" maxWidth="Infinity"/>
            <Button text="Clear form" styleClass="btn-secondary, btn-form" onAction="#handleClearForm" maxWidth="Infinity"/>
        </VBox>
    </VBox>

</HBox>