<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dk.easv.scanova.GUI.ProfileController">

    <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>

    <VBox styleClass="panel" HBox.hgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 14 16 14 16;
                     -fx-border-color: transparent transparent #E2E8F0 transparent;
                     -fx-border-width: 0 0 0.5 0;">
            <Label text="All profiles" styleClass="panel-title"/>
            <Label fx:id="profileCountBadge" text="0"
                   style="-fx-background-color: #F0F2F5;
                          -fx-text-fill: #718096;
                          -fx-background-radius: 20;
                          -fx-padding: 1 8; -fx-font-size: 11px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ New profile"
                    styleClass="btn-primary"
                    onAction="#handleNewProfile"
                    style="-fx-padding: 6 14; -fx-font-size: 12px;"/>
        </HBox>

        <TableView fx:id="profileTable"
                   VBox.vgrow="ALWAYS"
                   prefHeight="320"
                   style="-fx-border-color: transparent;
                          -fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="colProfileName"
                             text="Name" prefWidth="150"/>
                <TableColumn fx:id="colProfileRotation"
                             text="Rotation" prefWidth="80"/>
                <TableColumn fx:id="colProfileBrightness"
                             text="Brightness" prefWidth="90"/>
                <TableColumn fx:id="colProfileClient"
                             text="Client" prefWidth="120"/>
            </columns>
            <placeholder>
                <Label text="No profiles found."
                       style="-fx-text-fill: #A0AEC0; -fx-font-size: 13px;"/>
            </placeholder>
        </TableView>

    </VBox>

    <!-- RIGHT — Profile form panel -->
    <VBox fx:id="createProfilePanel" styleClass="panel" prefWidth="300">

        <!-- Form header -->
        <VBox spacing="2"
              style="-fx-padding: 16 16 14 16;
                     -fx-border-color: transparent transparent #E2E8F0 transparent;
                     -fx-border-width: 0 0 0.5 0;">
            <Label fx:id="profileFormTitle"
                   text="Create new profile"
                   styleClass="panel-title"/>
            <Label text="Fill in the details below"
                   style="-fx-text-fill: #A0AEC0; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Form fields -->
        <VBox spacing="14">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <!-- Name -->
            <VBox spacing="5">
                <Label text="Profile name"
                       style="-fx-text-fill: #4A5568; -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>
                <TextField fx:id="profileNameField"
                           promptText="e.g. Default"
                           styleClass="text-field"/>
            </VBox>

            <!-- Rotation -->
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Rotation"
                           style="-fx-text-fill: #4A5568; -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>
                    <Label fx:id="profileRotationValueLabel"
                           text="0°"
                           style="-fx-text-fill: #2ECC9A;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>
                </HBox>
                <Slider fx:id="profileRotationSlider"
                        min="-180" max="180" value="0"
                        showTickMarks="true"
                        showTickLabels="true"
                        majorTickUnit="90"/>
            </VBox>

            <!-- Brightness -->
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Brightness"
                           style="-fx-text-fill: #4A5568; -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>
                    <Label fx:id="profileBrightnessValueLabel"
                           text="1.0"
                           style="-fx-text-fill: #2ECC9A;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>
                </HBox>
                <Slider fx:id="profileBrightnessSlider"
                        min="0.1" max="3.0" value="1.0"
                        showTickMarks="true"
                        showTickLabels="true"
                        majorTickUnit="1"/>
            </VBox>

            <!-- Client dropdown -->
            <VBox spacing="5">
                <Label text="Client"
                       style="-fx-text-fill: #4A5568; -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>
                <ComboBox fx:id="profileClientComboBox"
                          promptText="Select a client"
                          maxWidth="Infinity"
                          styleClass="combo-box"/>
            </VBox>

            <!-- Feedback -->
            <Label fx:id="profileFeedbackLabel"
                   text=""
                   wrapText="true"
                   style="-fx-font-size: 12px; -fx-min-height: 18;"/>

            <!-- Save -->
            <Button fx:id="profileSaveButton"
                    text="Create profile"
                    styleClass="btn-primary"
                    onAction="#handleSaveProfile"
                    maxWidth="Infinity"
                    style="-fx-padding: 10; -fx-font-size: 13px;"/>

            <!-- Clear -->
            <Button text="Clear form"
                    styleClass="btn-secondary"
                    onAction="#handleClearForm"
                    maxWidth="Infinity"
                    style="-fx-padding: 10; -fx-font-size: 13px;"/>

        </VBox>
    </VBox>

</HBox>