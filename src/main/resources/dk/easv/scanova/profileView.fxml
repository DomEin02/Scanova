<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dk.easv.scanova.GUI.ProfileController">

    <VBox styleClass="panel" HBox.hgrow="ALWAYS">
        <HBox styleClass="panel-header" alignment="CENTER_LEFT" spacing="10">
            <Label text="All profiles" styleClass="panel-title"/>
            <Label fx:id="profileCountBadge" text="0" styleClass="count-badge"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ New profile" styleClass="btn-primary, btn-panel-header" onAction="#handleClearForm"/>
        </HBox>

        <TableView fx:id="profileTable" VBox.vgrow="ALWAYS" prefHeight="320" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colProfileName"       text="Name"       prefWidth="150"/>
                <TableColumn fx:id="colProfileRotation"   text="Rotation"   prefWidth="80"/>
                <TableColumn fx:id="colProfileBrightness" text="Brightness" prefWidth="90"/>
                <TableColumn fx:id="colProfileClient"     text="Client"     prefWidth="120"/>
                <TableColumn fx:id="colProfileStatus"     text="Status"     prefWidth="80"/>
            </columns>
            <placeholder><Label text="No profiles found." styleClass="page-subtitle"/></placeholder>
        </TableView>
    </VBox>

    <VBox styleClass="panel" prefWidth="300">
        <VBox styleClass="form-header">
            <Label fx:id="profileFormTitle" text="Create new profile" styleClass="panel-title"/>
            <Label text="Fill in the details below" styleClass="form-header-hint"/>
        </VBox>
        <VBox spacing="14">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <VBox spacing="5">
                <Label text="Profile name" styleClass="field-label"/>
                <TextField fx:id="profileNameField" promptText="e.g. Default" styleClass="text-field"/>
            </VBox>
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Rotation" styleClass="field-label"/>
                    <Label fx:id="profileRotationValueLabel" text="0°" styleClass="feedback-success"/>
                </HBox>
                <Slider fx:id="profileRotationSlider" min="-180" max="180" value="0"
                        showTickMarks="true" showTickLabels="true" majorTickUnit="90"/>
            </VBox>
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Brightness" styleClass="field-label"/>
                    <Label fx:id="profileBrightnessValueLabel" text="1.0" styleClass="feedback-success"/>
                </HBox>
                <Slider fx:id="profileBrightnessSlider" min="0.1" max="3.0" value="1.0"
                        showTickMarks="true" showTickLabels="true" majorTickUnit="1"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Client" styleClass="field-label"/>
                <ComboBox fx:id="profileClientComboBox" promptText="Select a client" maxWidth="Infinity" styleClass="combo-box"/>
            </VBox>
            <Label fx:id="profileFeedbackLabel" text="" styleClass="feedback-label"/>
            <Button fx:id="profileSaveButton" text="Create profile" styleClass="btn-primary, btn-form" onAction="#handleSaveProfile" maxWidth="Infinity"/>
            <Button text="Clear form" styleClass="btn-secondary, btn-form" onAction="#handleClearForm" maxWidth="Infinity"/>
        </VBox>
    </VBox>

</HBox>