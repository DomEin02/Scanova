<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dk.easv.scanova.GUI.ProfileController">

    <!-- LEFT — Profile table -->
    <VBox styleClass="panel" HBox.hgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 14 16 14 16;
                     -fx-border-color: transparent transparent #E2E8F0 transparent;
                     -fx-border-width: 0 0 0.5 0;">
            <Label text="All Profiles" styleClass="panel-title"/>
            <Label fx:id="profileCountBadge" text="0"
                   style="-fx-background-color: #F0F2F5;
                          -fx-text-fill: #718096;
                          -fx-background-radius: 20;
                          -fx-padding: 1 8; -fx-font-size: 11px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ New profile"
                    styleClass="btn-primary"
                    onAction="#handleClearForm"
                    style="-fx-padding: 6 14; -fx-font-size: 12px;"/>
        </HBox>

        <TableView fx:id="profileTable"
                   VBox.vgrow="ALWAYS"
                   prefHeight="350"
                   style="-fx-border-color: transparent;
                          -fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="colProfileId"
                             text="ID"         prefWidth="50"/>
                <TableColumn fx:id="colProfileName"
                             text="Name"       prefWidth="160"/>
                <TableColumn fx:id="colProfileRotation"
                             text="Rotation"   prefWidth="90"/>
                <TableColumn fx:id="colProfileBrightness"
                             text="Brightness" prefWidth="90"/>
                <TableColumn fx:id="colProfileClientId"
                             text="Client ID"  prefWidth="80"/>
            </columns>
            <placeholder>
                <Label text="No profiles found."
                       style="-fx-text-fill: #A0AEC0; -fx-font-size: 13px;"/>
            </placeholder>
        </TableView>

        <HBox spacing="8"
              style="-fx-padding: 12 16;
                     -fx-border-color: #E2E8F0 transparent transparent transparent;
                     -fx-border-width: 0.5 0 0 0;">
            <Button text="Edit selected"
                    styleClass="btn-secondary"
                    onAction="#handleEditProfile"
                    style="-fx-padding: 7 16; -fx-font-size: 12px;"/>
            <Button text="Delete selected"
                    styleClass="btn-danger"
                    onAction="#handleDeleteProfile"
                    style="-fx-padding: 7 16; -fx-font-size: 12px;"/>
        </HBox>
    </VBox>

    <!-- RIGHT — Profile form -->
    <VBox styleClass="panel" prefWidth="290">

        <VBox spacing="2"
              style="-fx-padding: 16 16 14 16;
                     -fx-border-color: transparent transparent #E2E8F0 transparent;
                     -fx-border-width: 0 0 0.5 0;">
            <Label fx:id="profileFormTitle" text="Create new profile"
                   styleClass="panel-title"/>
            <Label text="Fill in the details below"
                   style="-fx-text-fill: #A0AEC0; -fx-font-size: 11px;"/>
        </VBox>

        <VBox spacing="14">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <!-- Name -->
            <VBox spacing="5">
                <Label text="Profile Name"
                       style="-fx-text-fill: #4A5568; -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>
                <TextField fx:id="profileNameField"
                           promptText="e.g. Default"
                           styleClass="text-field"/>
            </VBox>

            <!-- Rotation -->
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Rotation"
                           style="-fx-text-fill: #4A5568; -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>
                    <Label fx:id="profileRotationValueLabel" text="0°"
                           style="-fx-text-fill: #2ECC9A;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>
                </HBox>
                <Slider fx:id="profileRotationSlider"
                        min="-180" max="180" value="0"
                        majorTickUnit="45"
                        showTickMarks="true"
                        showTickLabels="true"/>
                <Label text="Steps of 5°. Applied to all pages in session."
                       style="-fx-text-fill: #A0AEC0; -fx-font-size: 10px;"/>
            </VBox>

            <!-- Brightness -->
            <VBox spacing="5">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Brightness"
                           style="-fx-text-fill: #4A5568; -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>
                    <Label fx:id="profileBrightnessValueLabel" text="1.0"
                           style="-fx-text-fill: #2ECC9A;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>
                </HBox>
                <Slider fx:id="profileBrightnessSlider"
                        min="0.1" max="3.0" value="1.0"
                        majorTickUnit="0.5"
                        showTickMarks="true"
                        showTickLabels="true"/>
                <Label text="1.0 = normal. Applied to all pages in session."
                       style="-fx-text-fill: #A0AEC0; -fx-font-size: 10px;"/>
            </VBox>

            <!-- Client -->
            <VBox spacing="5">
                <Label text="Client"
                       style="-fx-text-fill: #4A5568; -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>
                <ComboBox fx:id="profileClientComboBox"
                          maxWidth="Infinity"
                          promptText="Select a client"
                          styleClass="combo-box"/>
                <Label text="Profile will only be available for this client's boxes."
                       style="-fx-text-fill: #A0AEC0; -fx-font-size: 10px;"/>
            </VBox>

            <Label fx:id="profileFeedbackLabel" text="" wrapText="true"
                   style="-fx-font-size: 12px; -fx-min-height: 18;"/>

            <Button fx:id="profileSaveButton"
                    text="Create profile"
                    styleClass="btn-primary"
                    onAction="#handleSaveProfile"
                    maxWidth="Infinity"
                    style="-fx-padding: 10; -fx-font-size: 13px;"/>

            <Button text="Clear form"
                    styleClass="btn-secondary"
                    onAction="#handleClearForm"
                    maxWidth="Infinity"
                    style="-fx-padding: 10; -fx-font-size: 13px;"/>

        </VBox>
    </VBox>

</HBox>