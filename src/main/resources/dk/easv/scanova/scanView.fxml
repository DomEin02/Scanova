<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="dk.easv.scanova.GUI.ScanViewController"
            prefHeight="800.0" prefWidth="1200.0">

    <top>
        <ToolBar>
            <Button text="Start Session" fx:id="startScanButton"
                    onAction="#onStartScan"/>
            <Button text="Scan Next (F1)" fx:id="scanNextButton"
                    onAction="#onScanNext"
                    style="-fx-background-color: #2ECC9A;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 5;"/>
            <Button text="Stop (F2)" fx:id="stopButton"
                    onAction="#onStopScan"/>
            <Button text="📂 Load Previous Scan"
                    fx:id="loadPreviousButton"
                    onAction="#onLoadPreviousScan"
                    style="-fx-background-color: #4A6A8A;
               -fx-text-fill: white;
               -fx-font-weight: bold;
               -fx-background-radius: 5;"/>
            <Button text="Review Mode (F3)" onAction="#onOpenSlideshow"
                    style="-fx-background-color: #1ABC9C;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 5;"/>
            <Separator />
            <Button text="Export TIFF (F4)" fx:id="exportButton"/>
            <Separator />
            <Label text="Profile:" />
            <ComboBox fx:id="profileComboBox" prefWidth="150"
                      focusTraversable="true"/>
            <Label text="Box ID:" />
            <TextField fx:id="boxIdField" prefWidth="100"
                       focusTraversable="true"/>
            <Separator />
            <Label text="F1 Scan  F2 Stop  F3 Review  F4 Export  ↑↓ Navigate  Del Remove"
                   style="-fx-text-fill: #888; -fx-font-size: 10;"/>
            <Separator />
            <Button text="Logout"
                    onAction="#handleLogout"
                    style="-fx-background-color: #EF4444;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 5;
                           -fx-cursor: hand;"/>
        </ToolBar>
    </top>

    <left>
        <VBox prefWidth="220" style="-fx-padding: 8; -fx-spacing: 6;">
            <Label text="Documents &amp; Files"
                   style="-fx-font-weight: bold; -fx-font-size: 13;"/>
            <ListView fx:id="fileListView" VBox.vgrow="ALWAYS"/>
            <HBox spacing="5">
                <Button text="↑" fx:id="moveUpButton" onAction="#onMoveUp"/>
                <Button text="↓" fx:id="moveDownButton" onAction="#onMoveDown"/>
                <Button text="Delete" fx:id="deleteButton"
                        onAction="#onDeleteFile"/>
            </HBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    hbarPolicy="NEVER" vbarPolicy="NEVER">
            <fx:include source="imagePreview.fxml"
                        fx:id="imagePreviewComponent"/>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="30"
              style="-fx-padding: 8; -fx-background-color: #f0f0f0;">
            <Label fx:id="scanCountLabel" text="Scans: 0 / 0"/>
            <Label fx:id="documentCountLabel" text="Documents: 0"/>
            <Label fx:id="statusLabel" text="Status: Ready"/>
        </HBox>
    </bottom>

</BorderPane>