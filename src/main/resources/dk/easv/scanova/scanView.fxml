<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="dk.easv.scanova.GUI.ScanViewController"
            prefHeight="800.0" prefWidth="1200.0">

    <top>
        <ToolBar>
            <Button text="▶ Start Session (F5)" fx:id="startScanButton"
                    onAction="#onStartScan"
                    style="-fx-background-color: #2ECC9A; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 5;"/>

            <Button text="Scan Next (F1)" fx:id="scanNextButton"
                    onAction="#onScanNext"
                    style="-fx-background-color: #1A7A5E; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 5;"/>

            <Button text="Stop (F2)" onAction="#onStopScan"/>

            <Separator/>

            <Button text="📂 Load Previous" fx:id="loadPreviousButton"
                    onAction="#onLoadPreviousScan"
                    style="-fx-background-color: #4A6A8A; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 5;"/>

            <Button text="Review (F3)" onAction="#onOpenSlideshow"
                    style="-fx-background-color: #1ABC9C; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 5;"/>

            <Button text="Export TIFF (F4)" onAction="#onExport"
                    style="-fx-background-color: #7C3AED; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 5;"/>

            <Separator/>

            <Button text="Split (M)" onAction="#onManualSplit"
                    style="-fx-background-color: #F6AD55; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 5;"/>

            <Button text="Merge (G)" onAction="#onMergeDocument"
                    style="-fx-background-color: #4A90D9; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 5;"/>

            <Separator/>

            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #EF4444; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 5;
                           -fx-cursor: hand;"/>
        </ToolBar>
    </top>

    <left>
        <VBox prefWidth="220" style="-fx-padding: 8; -fx-spacing: 6;">
            <Label text="Documents &amp; Files"
                   style="-fx-font-weight: bold; -fx-font-size: 13;"/>
            <ListView fx:id="fileListView" VBox.vgrow="ALWAYS"/>
            <HBox spacing="5">
                <Button text="↑" onAction="#onMoveUp"/>
                <Button text="↓" onAction="#onMoveDown"/>
                <Button text="Delete" onAction="#onDeleteFile"/>
            </HBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    hbarPolicy="NEVER" vbarPolicy="NEVER">
            <fx:include source="imagePreview.fxml"
                        fx:id="imagePreviewComponent"/>
        </ScrollPane>
    </center>

    <bottom>
        <VBox style="-fx-background-color: #f0f0f0;">
            <HBox spacing="30" style="-fx-padding: 8;">
                <Label fx:id="scanCountLabel"    text="Scans: 0 / 0"/>
                <Label fx:id="documentCountLabel" text="Documents: 0"/>
                <Label fx:id="statusLabel"        text="Status: Ready — press F5 to start"/>
            </HBox>
            <Label styleClass="shortcut-bar"
                   text="F1 Scan Next  F2 Stop  F3 Review  F4 Export  F5 New Session  M Split  G Merge  ↑↓ Move  Del Remove"/>
        </VBox>
    </bottom>

</BorderPane>