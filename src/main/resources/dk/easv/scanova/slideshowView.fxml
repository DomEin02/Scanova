<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="dk.easv.scanova.GUI.SlideshowController"
            prefWidth="1000" prefHeight="750">

    <!-- TOP: file info -->
    <top>
        <VBox style="-fx-background-color: #1A2E4A; -fx-padding: 10; -fx-spacing: 4;">
            <Label fx:id="fileIndexLabel" text="File 0 of 0"
                   style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
            <Label fx:id="docLabel" text="Document —"
                   style="-fx-text-fill: #1ABC9C; -fx-font-size: 13;"/>
        </VBox>
    </top>

    <!-- CENTER: image -->
    <center>
        <StackPane style="-fx-background-color: #2c2c2c;">
            <ImageView fx:id="slideshowImageView"
                       preserveRatio="true"
                       fitWidth="900"
                       fitHeight="620"/>
        </StackPane>
    </center>

    <!-- BOTTOM: nav buttons -->
    <bottom>
        <HBox spacing="20"
              style="-fx-padding: 14; -fx-alignment: center; -fx-background-color: #f0f0f0;">
            <Button text="◀  Previous" onAction="#onPrevious"
                    style="-fx-font-size: 14; -fx-padding: 8 24;
                           -fx-background-color: #1A2E4A; -fx-text-fill: white;
                           -fx-background-radius: 5;"/>
            <Button text="Next  ▶" onAction="#onNext"
                    style="-fx-font-size: 14; -fx-padding: 8 24;
                           -fx-background-color: #1ABC9C; -fx-text-fill: white;
                           -fx-background-radius: 5;"/>
        </HBox>
    </bottom>

</BorderPane>